#!/bin/bash

#############################################################################################################################
## SOURCE
#############################################################################################################################

source .GOBOX-LIB

#############################################################################################################################
## DEBUG
#############################################################################################################################

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER IMAGE NAME                                                       #"
echo "#                                                                         #"
echo "###########################################################################"
echo

echo "The (expected) Docker image-name should be:"
echo "${IMAGE_NAME}"
echo

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# LINUX USER NAME                                                         #"
echo "#                                                                         #"
echo "###########################################################################"
echo

echo "The Linux user-name (inside the container) should be:"
echo "${USER_NAME}"
echo

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER CONTAINER NAME                                                   #"
echo "#                                                                         #"
echo "###########################################################################"
echo

echo "The (expected) Docker container-name should be:"
echo "${CONTAINER_NAME}"
echo

#############################################################################################################################
## MAIN
#############################################################################################################################

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER IMAGES                                                           #"
echo "#                                                                         #"
echo "###########################################################################"
echo

docker images

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER CONTAINERS (ALL)                                                 #"
echo "#                                                                         #"
echo "###########################################################################"
echo

docker ps -a

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER CONTAINERS                                                       #"
echo "#                                                                         #"
echo "###########################################################################"
echo

docker ps

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# CREATING NEW DOCKER CONTAINER, AND — WE ARE GOING IN                    #"
echo "#                                                                         #"
echo "###########################################################################"
echo

docker run                                              \
	-v "./Workspaces:/home/${USER_NAME}/Workspaces" \
	--name "${CONTAINER_NAME}"                      \
	-d                                              \
	"${IMAGE_NAME}"

echo
echo "###########################################################################"
echo "#                                                                         #"
echo "# DOCKER CONTAINER NAME                                                   #"
echo "#                                                                         #"
echo "###########################################################################"
echo

echo "The Docker container was created at:"
echo "${CONTAINER_NAME}"
echo
echo "You should NOT have to do this very often."
echo
echo "You should probably run GOBOX-EXEC next."
echo
